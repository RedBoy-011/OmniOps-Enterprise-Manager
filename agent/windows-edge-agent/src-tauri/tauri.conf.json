{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniOps Windows Edge Agent",
  "version": "2.4.0",
  "identifier": "com.omniops.enterprise.winagent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OmniOps Edge Agent",
        "width": 460,
        "height": 260,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "center": false,
        "x": 600,
        "y": 10
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
